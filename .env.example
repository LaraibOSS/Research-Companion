# Research Companion — copy to .env and fill in what you need.
#   cp .env.example .env && chmod 600 .env
# .env is gitignored. Never commit real keys.

# --- Model access: you need ONE of these two -------------------------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Which provider to use by default, and an optional model override.
# RESEARCH_COMPANION_PROVIDER=anthropic
# RESEARCH_COMPANION_MODEL=

# --- Optional ---------------------------------------------------------------
# Hybrid semantic search. Without it, retrieval falls back to BM25 keyword
# search — everything still works, results are just less semantic.
# HF_TOKEN=

# Where papers and the graph are stored.
# RESEARCH_COMPANION_DIR=~/.research-companion

# Pin one research (workspace) for a single command. Skills use this to write
# to a scratch workspace instead of whichever research you last had open.
# RESEARCH_COMPANION_WORKSPACE=

# Force a PDF parser instead of auto-detecting: pypdfium (fast) or docling
# (better structure, slower, downloads models on first use).
# RESEARCH_COMPANION_PARSER=

# Biomedical connectors: identifying yourself raises NCBI rate limits from
# 3 to 10 requests/second. Neither is required.
# NCBI_EMAIL=
# NCBI_API_KEY=
