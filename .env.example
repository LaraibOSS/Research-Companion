# Research Companion — copy to .env and fill in what you need.
#   cp .env.example .env && chmod 600 .env
# .env is gitignored. Never commit real keys.

# --- Model access: you need ONE of these ----------------------------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# ...or a local/self-hosted model (see below), which needs no key.

# Which provider to use by default (anthropic, openai, ollama,
# openai_compatible), and the model. The model is REQUIRED for ollama and
# openai_compatible: there is no default to fall back on.
# RESEARCH_COMPANION_PROVIDER=anthropic
# RESEARCH_COMPANION_MODEL=

# Local model through Ollama (provider=ollama). No key, no per-token cost.
# Context length is sent with every request; extraction needs ~14k tokens,
# and a request that does not fit is refused rather than silently cut.
# RESEARCH_COMPANION_OLLAMA_URL=http://localhost:11434
# RESEARCH_COMPANION_OLLAMA_NUM_CTX=16384

# Any server speaking the OpenAI chat API (provider=openai_compatible):
# vLLM, LM Studio, llama.cpp server, a gateway. The key is optional.
# Its price is unknown to the tool, so cost estimates read "price not known".
# RESEARCH_COMPANION_BASE_URL=http://localhost:8000/v1
# RESEARCH_COMPANION_API_KEY=

# --- Optional ---------------------------------------------------------------
# Hybrid semantic search. Without it, retrieval falls back to BM25 keyword
# search — everything still works, results are just less semantic.
# HF_TOKEN=

# Where papers and the graph are stored.
# RESEARCH_COMPANION_DIR=~/.research-companion

# Pin one research (workspace) for a single command. Skills use this to write
# to a scratch workspace instead of whichever research you last had open.
# RESEARCH_COMPANION_WORKSPACE=

# Force a PDF parser instead of auto-detecting: pypdfium (fast) or docling
# (better structure, slower, downloads models on first use).
# RESEARCH_COMPANION_PARSER=

# How many papers the Lab parses and analyses at once (1-8, default 2). Lower
# it if adding many papers at once runs out of memory.
# RESEARCH_COMPANION_MAX_INGESTS=

# Biomedical connectors: identifying yourself raises NCBI rate limits from
# 3 to 10 requests/second. Neither is required.
# NCBI_EMAIL=
# NCBI_API_KEY=
